fn lcg_next(int seed) -> int {
	return (seed * 1103515245 + 12345) % 2147483647;
}

fn main() {
	int n = 20000;
	int[] nums = [];
	int seed = 42;

	for (int i : 0..n - 1) {
		seed = lcg_next(seed);
		stdlib.push(nums, seed % 1000000);
	}

	stdlib.sort(nums, fn(int a, int b) -> bool { return a < b; });

	print(nums[0]);
	print(nums[n - 1]);
}
