fn main() {
	assert(1 + 2 == 3);
	assert(10 - 4 == 6);
	assert(3 * 4 == 12);
	assert(10 / 3 == 3);
	assert(10 % 3 == 1);
	assert(1 + 2 * 3 - 4 / 2 == 5, "precedence: * and / bind tighter than + and -");
	assert(-7 + 7 == 0);

	assert(2.5 + 2.5 == 5.0);
	assert(3.0 * 2 == 6.0, "int should promote to float");

	// Both-float fast path (JIT: emit_op_arith_or_cmp/emit_op_div_mod's
	// SSE2 branch) alongside mixed int/float above, which stays on the
	// slow path unchanged.
	float fa = 7.5;
	float fb = 2.0;
	assert(fa + fb == 9.5, "float add fast path");
	assert(fa - fb == 5.5, "float subtract fast path");
	assert(fa * fb == 15.0, "float multiply fast path");
	assert(fa / fb == 3.75, "float divide fast path");
	assert(fb < fa && fb <= fa && fa > fb && fa >= fb, "float relational fast path");
	assert(fa <= fa && fa >= fa, "float relational fast path, equal operands");

	// IEEE-754 edge cases: the JIT's UCOMISD-based comparisons use a
	// reversed-operand pattern specifically to get "any relational
	// comparison against NaN is false" for free (see
	// emit_op_arith_or_cmp's own comment). Worth asserting directly
	// rather than trusting the reasoning alone.
	float fzero = 0.0;
	float fnan = fzero / fzero;
	assert(!(fnan < 1.0) && !(fnan <= 1.0) && !(fnan > 1.0) && !(fnan >= 1.0), "any comparison against NaN is false");
	assert(!(fnan < fnan) && !(fnan <= fnan) && !(fnan > fnan) && !(fnan >= fnan), "NaN compared to itself is false too");
	float fposinf = 1.0 / fzero;
	float fneginf = -1.0 / fzero;
	assert(fposinf > 1000000.0, "1.0/0.0 is +inf, not a trap");
	assert(fneginf < -1000000.0, "-1.0/0.0 is -inf, not a trap");

	assert(1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 3);
	assert(1 != 2);
	assert(!(1 == 2));

	assert(true && false || true, "&& binds tighter than ||");
	assert(!(false && true));

	print("arithmetic: ok");
}
