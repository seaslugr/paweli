struct Counter {
	int value;
}

fn main() {
	int side_effect_calls = 0;

	fn index_with_side_effect() -> int {
		side_effect_calls = side_effect_calls + 1;
		return 0;
	}
	// Local variable target, all ten forms.
	int x = 10;
	x += 5; assert(x == 15);
	x -= 3; assert(x == 12);
	x *= 2; assert(x == 24);
	x /= 4; assert(x == 6);
	x %= 4; assert(x == 2);
	x &= 3; assert(x == 2);
	x |= 5; assert(x == 7);
	x ^= 1; assert(x == 6);
	x <<= 2; assert(x == 24);
	x >>= 3; assert(x == 3);

	// Compound assignment is an expression: it produces the new value.
	int y = 1;
	assert((y += 4) == 5);
	assert(y == 5);

	// Array element target.
	int[] nums = [1, 2, 3];
	nums[1] += 10;
	assert(nums[1] == 12);
	nums[0] *= 5;
	assert(nums[0] == 5);

	// Struct field target.
	Counter c = Counter { value: 100 };
	c.value -= 30;
	assert(c.value == 70);
	c.value &= 15;
	assert(c.value == 6);

	// Side effects in the target's sub-expressions must run exactly
	// once, not once for the read and again for the write.
	assert(side_effect_calls == 0);
	nums[index_with_side_effect()] += 1;
	assert(side_effect_calls == 1);
	assert(nums[0] == 6);

	print("compound assign ok");
}
