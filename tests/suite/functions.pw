#moduledef "functions"

// Overloaded: int, float, and string versions, shared by several tests
// below (functions.pw, overloading.pw, and first_class_functions.pw all
// originally declared their own copy of some of these; declared once
// here since they'd otherwise collide as duplicate signatures in one
// file).
fn add(int a, int b) -> int {
	return a + b;
}
fn add(float a, float b) -> float {
	return a + b;
}
fn add(string a, string b) -> string {
	return stdlib.concat(a, b);
}

fn recurse(int n) -> int {
	if (n <= 0) {
		return 0;
	}
	return 1 + recurse(n - 1);
}

fn no_return() {
	int x = 1;
}

fn early_return(int n) -> int {
	if (n < 0) {
		return -1;
	}
	return n;
}

fn shadow_test() -> int {
	int x = 1;
	{
		int x = 2;
		assert(x == 2);
	}
	return x;
}

fn triple(int n) -> int {
	return n * 3;
}

fn quadruple(int n) -> int {
	return n * 4;
}

// A regression test for the JIT's inline caching of OP_GET_GLOBAL/
// OP_GET_PROPERTY (jit_compile.c's jit_table_cache_t): three distinct
// call sites in one function (add/triple/quadruple, each a separate
// OP_GET_GLOBAL with its own cache cell) plus a repeated
// stdlib.length/stdlib.push call pair (separate OP_GET_PROPERTY cache
// cells sharing the same stdlib module receiver) running for enough
// iterations that every cache cell here goes from its first cold miss
// to many warm hits. Exercises per-call-site cache-index bookkeeping
// specifically: if two sites' indices were ever accidentally aliased,
// one call's result would silently corrupt another's.
fn mixed_global_calls(int n) -> int {
	int[] seen = [];
	int total = 0;
	int i = 0;
	while (i < n) {
		total = total + add(i, 1);
		total = total + triple(i);
		total = total + quadruple(i);
		stdlib.push(seen, i);
		total = total + stdlib.length(seen);
		i = i + 1;
	}
	return total;
}

// Regression test for the JIT's call-site inline caching under the
// exact shape it's meant for (jit_compile.c's jit_call_cache_t): a
// self-recursive call site revisited many times *within one call
// chain*, unlike recurse() above (linear, each level calls exactly
// once). fib_calls's own recursive call site sees the same callee
// (itself) over and over across the recursion tree, so once the cache
// warms up partway through, the overwhelming majority of the ~2 * this
// count's own worth of calls hit the fast path. Verified directly
// during development (a temporary debug counter showed only a
// double-digit number of slow-path calls out of hundreds of thousands
// for fib(25)), not just assumed from the shape of the recursion.
fn fib_calls(int n) -> int {
	if (n < 2) {
		return n;
	}
	return fib_calls(n - 1) + fib_calls(n - 2);
}

fn test_basic_calls() {
	assert(add(2, 3) == 5);
	assert(recurse(50) == 50);
}

fn test_call_site_caching_branching_recursion() {
	assert(fib_calls(15) == 610, "call-site caching under heavy same-site reuse (branching recursion) must still be correct");
}

// Two separate top-level calls into the same linear-recursion call
// site: recurse()'s own self-call can never warm its cache *within*
// one chain (see error_handling.pw's deep_recursion() for why: each
// level only ever calls once, and the cache-populating write only
// lands on unwind, after that level's own one chance to use it has
// already passed), but a *second*, separate call to recurse() should
// see every one of its recursive calls hit an already-warm cache. Both
// must still produce the same correct result either way.
fn test_call_site_caching_separate_calls() {
	assert(recurse(30) == 30, "a second, separate call through the same self-recursive call site must still be correct once its cache is warm");
}

fn test_implicit_null_return() {
	assert(no_return() == null, "a function with no explicit return should evaluate to null");
}

fn test_early_return() {
	assert(early_return(-5) == -1);
	assert(early_return(5) == 5);
}

fn test_shadowing() {
	assert(shadow_test() == 1, "outer x should be unaffected by the inner shadowed x");
}

fn test_jit_inline_cache_no_cross_contamination() {
	assert(mixed_global_calls(200) == 179500, "multiple distinct JIT inline-cache cells in one function must not cross-contaminate");
}

fn test_overloading_by_type() {
	assert(add(1, 2) == 3);
	assert(add(1.5, 2.5) == 4.0);
	assert(add("foo", "bar") == "foobar");
}

fn greet(string name) -> string {
	return stdlib.concat("Hello, ", name);
}
fn greet(string first, string last) -> string {
	return greet(stdlib.concat(stdlib.concat(first, " "), last));
}

fn test_overloading_by_arity() {
	assert(greet("Alice") == "Hello, Alice");
	assert(greet("Alice", "Smith") == "Hello, Alice Smith");
}

fn double(int x) -> int {
	return x * 2;
}

fn apply_twice(fn(int) -> int f, int x) -> int {
	return f(f(x));
}

fn make_adder(int amount) -> fn(int) -> int {
	fn adder(int x) -> int {
		return x + amount;
	}
	return adder;
}

struct Handler {
	fn(int) -> int callback;
}

fn test_function_value_variable() {
	// A named function stored in a variable, called through it.
	fn(int, int) -> int op = add;
	assert(op(2, 3) == 5);

	// The same name, disambiguated by the expected type context when
	// it's overloaded.
	fn(float, float) -> float float_op = add;
	assert(float_op(2.5, 1.5) == 4.0);
}

fn test_function_value_callback() {
	assert(apply_twice(double, 5) == 20);
}

fn test_function_value_closure_factory() {
	// A factory returning a closure to its caller, which keeps working
	// after the call that created it has returned.
	fn(int) -> int add5 = make_adder(5);
	fn(int) -> int add10 = make_adder(10);
	assert(add5(1) == 6);
	assert(add5(2) == 7);
	assert(add10(1) == 11);
}

fn test_function_value_lambda_literal() {
	// A lambda literal used inline as a call argument, and stored in a
	// variable and called through it.
	assert(apply_twice(fn(int x) -> int { return x + 1; }, 10) == 12);
	fn(int) -> bool is_even = fn(int x) -> bool { return x % 2 == 0; };
	assert(is_even(4));
	assert(!is_even(5));
}

fn test_function_value_struct_field() {
	// A struct field holding a function value: a named function and a
	// lambda.
	Handler h = Handler { callback: triple };
	assert(h.callback(4) == 12);
	Handler h2 = Handler { callback: fn(int x) -> int { return x + 100; } };
	assert(h2.callback(4) == 104);
}

// stdlib.sort with a paweli-defined comparator: int and string element
// types (the latter exercising a native callback on a heap-allocated
// value, not just a copyable primitive).
fn test_stdlib_sort_with_comparator() {
	int[] nums = [5, 1, 4, 2, 8, 1, 9, 3];
	stdlib.sort(nums, fn(int a, int b) -> bool { return a < b; });
	assert(nums[0] == 1);
	assert(nums[7] == 9);

	string[] words = ["banana", "kiwi", "fig", "watermelon"];
	stdlib.sort(words, fn(string a, string b) -> bool { return stdlib.length(a) < stdlib.length(b); });
	assert(words[0] == "fig");
	assert(words[3] == "watermelon");

	int[] empty = [];
	stdlib.sort(empty, fn(int a, int b) -> bool { return a < b; });

	int[] one = [42];
	stdlib.sort(one, fn(int a, int b) -> bool { return a < b; });
	assert(one[0] == 42);
}

fn main() {
	export test_basic_calls;
	export test_call_site_caching_branching_recursion;
	export test_call_site_caching_separate_calls;
	export test_implicit_null_return;
	export test_early_return;
	export test_shadowing;
	export test_jit_inline_cache_no_cross_contamination;
	export test_overloading_by_type;
	export test_overloading_by_arity;
	export test_function_value_variable;
	export test_function_value_callback;
	export test_function_value_closure_factory;
	export test_function_value_lambda_literal;
	export test_function_value_struct_field;
	export test_stdlib_sort_with_comparator;
}
