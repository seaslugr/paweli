#moduledef "error_handling"

fn divide(int a, int b) -> int {
	if (b == 0) {
		throw "division by zero";
	}
	return a / b;
}

// Postfix catch: pure sugar over a try-block containing just the one
// expression, a fallback but no binding and no body.
fn test_postfix_catch() {
	assert(divide(10, 0) catch(int -1) == -1);
	assert(divide(10, 2) catch(int -1) == 5);
}

// Block form used as a statement: binding only, no fallback, the value
// (if any) is discarded. Here the point is the side effect in the
// catch body, not a produced value.
fn test_block_form_as_statement() {
	int last_error_len = 0;

	try {
		int x = divide(1, 0);
		print(x);
	} catch(string message) {
		if (message == "division by zero") {
			last_error_len = 17;
		}
	}

	assert(last_error_len == 17);
}

// Block form used as an expression: binding AND fallback together, the
// try-block's trailing bare expression (no semicolon) is its value.
fn block_form_as_expression() -> int {
	string seen = "";

	int result = try {
		divide(10, 0)
	} catch(string message : int -99) {
		seen = message;
	};

	assert(seen == "division by zero");
	return result;
}

fn test_block_form_as_expression() {
	assert(block_form_as_expression() == -99);
}

fn nested_try_catch() -> int {
	int outer = try {
		int inner = try {
			divide(1, 0)
		} catch(int -1) {
		};
		divide(inner, 0)
	} catch(int -2) {
	};
	return outer;
}

fn test_nested_try_catch() {
	assert(nested_try_catch() == -2);
}

// throw is just another way to reach the same catchable-error channel a
// VM-triggered failure (like division by zero) already uses. The catch
// binding carries the thrown message; the fallback is a separate value
// supplied by the catch clause itself, not derived from the message.
fn test_raise_and_catch_custom_error() {
	string seen = "";

	string result = try {
		throw "custom failure";
		"unreachable"
	} catch(string message : string "fallback") {
		seen = message;
	};

	assert(seen == "custom failure");
	assert(result == "fallback");
}

// A failing try-block several frames deep, after mutating a local it
// closed over. Exercises close_upvalues() collapsing every frame the
// reentrant call pushed in one step, not just the immediate one.
fn deeply_nested_failure_after_mutation() -> int {
	int shared = 0;

	fn level_three() {
		shared = shared + 1;
		throw "failed at level three";
	}

	fn level_two() {
		shared = shared + 1;
		level_three();
	}

	fn level_one() {
		shared = shared + 1;
		level_two();
	}

	int fallback = try {
		level_one();
		0
	} catch(int 1) {
	};

	assert(shared == 3, "every frame's mutation should be visible even though the call ultimately failed");
	assert(fallback == 1);
	return shared;
}

fn test_deeply_nested_failure_after_mutation() {
	assert(deeply_nested_failure_after_mutation() == 3);
}

// Regression test for the JIT's call-site inline caching (OP_CALL,
// jit_compile.c's jit_call_cache_t): the frame-count overflow check
// (frame_count >= max_frames) used to only ever run inside
// call_value()'s own C code; a cache hit now inlines it directly into
// JIT'd code instead, so it needs its own dedicated coverage rather
// than trusting "the existing suite still passes" to exercise it.
// deep_recursion() recurses far past VM_DEFAULT_MAX_FRAMES (256) with
// no base case that stops it. Every one of those calls goes through
// the identical static call site (deep_recursion() calling itself),
// so by the time the real limit is hit, the fast path is what's
// making every one of those calls, not the slow path.
fn deep_recursion(int n) -> int {
	return 1 + deep_recursion(n + 1);
}

fn test_call_stack_overflow_reported_correctly() {
	string seen = "";

	try {
		deep_recursion(0);
	} catch(string message) {
		seen = message;
	}

	assert(seen == "call stack overflow", "the frame-count overflow check inlined into the JIT's OP_CALL fast path must report the exact same error call_value() always has");
}

fn main() {
	export test_postfix_catch;
	export test_block_form_as_statement;
	export test_block_form_as_expression;
	export test_nested_try_catch;
	export test_raise_and_catch_custom_error;
	export test_deeply_nested_failure_after_mutation;
	export test_call_stack_overflow_reported_correctly;
}
