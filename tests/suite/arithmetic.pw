#moduledef "arithmetic"

fn test_basic_ops() {
	assert(1 + 2 == 3);
	assert(10 - 4 == 6);
	assert(3 * 4 == 12);
	assert(10 / 3 == 3);
	assert(10 % 3 == 1);
	assert(1 + 2 * 3 - 4 / 2 == 5, "precedence: * and / bind tighter than + and -");
	assert(-7 + 7 == 0);
}

fn test_float_ops() {
	assert(2.5 + 2.5 == 5.0);
	assert(3.0 * 2 == 6.0, "int should promote to float");
}

// Both-float fast path (JIT: emit_op_arith_or_cmp/emit_op_div_mod's SSE2
// branch) alongside mixed int/float above, which stays on the slow path
// unchanged.
fn test_float_fast_path() {
	float fa = 7.5;
	float fb = 2.0;
	assert(fa + fb == 9.5, "float add fast path");
	assert(fa - fb == 5.5, "float subtract fast path");
	assert(fa * fb == 15.0, "float multiply fast path");
	assert(fa / fb == 3.75, "float divide fast path");
	assert(fb < fa && fb <= fa && fa > fb && fa >= fb, "float relational fast path");
	assert(fa <= fa && fa >= fa, "float relational fast path, equal operands");
}

// IEEE-754 edge cases: the JIT's UCOMISD-based comparisons use a
// reversed-operand pattern specifically to get "any relational comparison
// against NaN is false" for free (see emit_op_arith_or_cmp's own
// comment). Worth asserting directly rather than trusting the reasoning
// alone.
fn test_float_nan_inf() {
	float fzero = 0.0;
	float fnan = fzero / fzero;
	assert(!(fnan < 1.0) && !(fnan <= 1.0) && !(fnan > 1.0) && !(fnan >= 1.0), "any comparison against NaN is false");
	assert(!(fnan < fnan) && !(fnan <= fnan) && !(fnan > fnan) && !(fnan >= fnan), "NaN compared to itself is false too");
	float fposinf = 1.0 / fzero;
	float fneginf = -1.0 / fzero;
	assert(fposinf > 1000000.0, "1.0/0.0 is +inf, not a trap");
	assert(fneginf < -1000000.0, "-1.0/0.0 is -inf, not a trap");
}

fn test_comparisons() {
	assert(1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 3);
	assert(1 != 2);
	assert(!(1 == 2));
}

fn test_logical_ops() {
	assert(true && false || true, "&& binds tighter than ||");
	assert(!(false && true));
}

fn test_bitwise_ops() {
	assert((6 & 3) == 2);
	assert((6 | 3) == 7);
	assert((6 ^ 3) == 5);
	assert(~0 == -1);
	assert(~5 == -6);
	assert((1 << 4) == 16);
	assert((256 >> 4) == 16);
	assert((1 << 0) == 1);
	assert((1 << 63) < 0);
	assert((-1 >> 1) == -1);
	int x = 12;
	assert((x & 8) == 8);
}

// Precedence: | loosest, then ^, then &, all above equality/comparison,
// but below the shift/additive/multiplicative tier.
fn test_bitwise_precedence() {
	assert((1 | 2 & 3) == (1 | (2 & 3)));
	assert((1 ^ 2 & 3) == (1 ^ (2 & 3)));
	assert((2 + 3 << 1) == ((2 + 3) << 1));
	assert((1 << 2 == 4) == ((1 << 2) == 4));
}

fn test_compound_assign_local() {
	int x = 10;
	x += 5; assert(x == 15);
	x -= 3; assert(x == 12);
	x *= 2; assert(x == 24);
	x /= 4; assert(x == 6);
	x %= 4; assert(x == 2);
	x &= 3; assert(x == 2);
	x |= 5; assert(x == 7);
	x ^= 1; assert(x == 6);
	x <<= 2; assert(x == 24);
	x >>= 3; assert(x == 3);
}

// Compound assignment is an expression: it produces the new value.
fn test_compound_assign_expression() {
	int y = 1;
	assert((y += 4) == 5);
	assert(y == 5);
}

fn test_compound_assign_array() {
	int[] nums = [1, 2, 3];
	nums[1] += 10;
	assert(nums[1] == 12);
	nums[0] *= 5;
	assert(nums[0] == 5);
}

struct Counter {
	int value;
}

fn test_compound_assign_struct_field() {
	Counter c = Counter { value: 100 };
	c.value -= 30;
	assert(c.value == 70);
	c.value &= 15;
	assert(c.value == 6);
}

// The target's sub-expressions (an index or member access) must run
// exactly once, not once for the read and again for the write.
fn test_compound_assign_single_evaluation() {
	int side_effect_calls = 0;

	fn index_with_side_effect() -> int {
		side_effect_calls = side_effect_calls + 1;
		return 0;
	}

	int[] nums = [1, 2, 3];
	assert(side_effect_calls == 0);
	nums[index_with_side_effect()] += 1;
	assert(side_effect_calls == 1);
	assert(nums[0] == 2);
}

fn main() {
	export test_basic_ops;
	export test_float_ops;
	export test_float_fast_path;
	export test_float_nan_inf;
	export test_comparisons;
	export test_logical_ops;
	export test_bitwise_ops;
	export test_bitwise_precedence;
	export test_compound_assign_local;
	export test_compound_assign_expression;
	export test_compound_assign_array;
	export test_compound_assign_struct_field;
	export test_compound_assign_single_evaluation;
}
