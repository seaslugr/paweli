#moduledef "structs"

struct Point {
	int x;
	int y;

	// Called only as `Point.origin()`. No UFCS/receiver sugar exists;
	// "self" below is just an ordinary parameter name with zero special
	// meaning to the compiler.
	fn origin() -> Point {
		return Point { x: 0, y: 0 };
	}

	fn length(Point self) -> float {
		return stdlib.sqrt(self.x * self.x + self.y * self.y);
	}

	// Overloading: struct functions get it for free, same as top-level
	// functions. The single-arg overload calls the two-arg one (a
	// struct function calling a sibling overload of its own name) and
	// Point.origin() (calling another of this struct's own functions).
	fn manhattan(Point self) -> int {
		return Point.manhattan(self, Point.origin());
	}

	fn manhattan(Point self, Point other) -> int {
		int dx = self.x - other.x;
		int dy = self.y - other.y;
		return stdlib.abs(dx) + stdlib.abs(dy);
	}

	// A struct function with a nested closure inside it, capturing the
	// struct function's own parameter. Confirms reusing
	// compile_function_decl() for struct functions didn't lose closures.
	fn scaled(Point self, int factor) -> Point {
		fn scale_one(int v) -> int {
			return v * factor;
		}
		return Point { x: scale_one(self.x), y: scale_one(self.y) };
	}
}

struct Line {
	Point start;
	Point end;

	// One struct's function calling a different struct's function.
	fn length(Line self) -> float {
		return Point.length(Point { x: self.end.x - self.start.x, y: self.end.y - self.start.y });
	}
}

struct Tuning {
	int base;
	float scale = 2.5;
	string label = "default";
}

struct Node {
	int value;
	Node next;
}

fn make_point(int x, int y) -> Point {
	return Point { x: x, y: y };
}

fn dist_sq(Point a, Point b) -> int {
	int dx = a.x - b.x;
	int dy = a.y - b.y;
	return dx * dx + dy * dy;
}

fn offset(Point p) -> Point {
	return { x: p.x + 1, y: p.y + 1 };
}

fn test_field_read_write() {
	Point p = Point { x: 1, y: 2 };
	assert(p.x == 1, "field read after construction");
	assert(p.y == 2, "field read after construction");

	Point q = Point { y: 20, x: 10 };
	assert(q.x == 10 && q.y == 20, "struct literal fields are order-independent");

	p.x = p.x + 100;
	assert(p.x == 101, "field write mutates the instance");
}

fn test_pass_return_functions() {
	Point r = make_point(3, 4);
	assert(dist_sq(r, Point { x: 0, y: 0 }) == 25, "structs pass into and return from functions");
}

fn test_nested_struct_fields() {
	Line l = Line { start: Point { x: 0, y: 0 }, end: Point { x: 3, y: 4 } };
	assert(l.end.x == 3, "nested struct field read");
	l.start.x = 9;
	assert(l.start.x == 9, "nested struct field write");
}

fn test_default_field_values() {
	Tuning t = Tuning { base: 5 };
	assert(t.base == 5 && t.scale == 2.5 && t.label == "default", "omitted fields fall back to their declared defaults");

	Tuning t2 = Tuning { base: 5, scale: 9.0, label: "custom" };
	assert(t2.scale == 9.0 && t2.label == "custom", "a default can still be overridden explicitly");
}

fn test_struct_equality_identity() {
	Point p = Point { x: 101, y: 2 };
	Point same_ref = p;
	assert(same_ref == p, "struct equality is identity, like arrays");
	Point different = Point { x: 101, y: 2 };
	assert(different != p, "a different instance with equal field values is not == (identity, not structural)");
}

fn test_self_referencing_struct() {
	Node tail = Node { value: 2, next: null };
	Node head = Node { value: 1, next: tail };
	assert(head.next.value == 2, "a struct field may reference its own struct type");
	assert(head.next.next == null, "null unifies with a struct-typed field");
}

fn test_bare_literal_inference() {
	Point inferred = { x: 5, y: 6 };
	assert(inferred.x == 5 && inferred.y == 6, "a bare '{ ... }' infers its type from a var_decl's declared type");

	inferred = { x: 7, y: 8 };
	assert(inferred.x == 7, "a bare '{ ... }' infers its type from an assignment target");

	Line nested = Line { start: { x: 0, y: 0 }, end: { x: 1, y: 1 } };
	assert(nested.end.y == 1, "a bare '{ ... }' infers its type from an enclosing struct literal's field type");

	Point moved = offset({ x: 1, y: 1 });
	assert(moved.x == 2 && moved.y == 2, "a bare '{ ... }' infers its type from a function's declared return type and a call argument's parameter type");

	Point[] pts = [{ x: 1, y: 1 }, { x: 2, y: 2 }];
	assert(pts[1].x == 2, "a bare '{ ... }' infers its type from an array literal's element type");
}

// Struct functions: always called as TypeName.name(args), never
// receiver.name(args). There is no UFCS.
fn test_struct_functions() {
	Point origin = Point.origin();
	assert(origin.x == 0 && origin.y == 0, "Point.origin() is a namespaced constructor");

	Point p34 = Point { x: 3, y: 4 };
	assert(Point.length(p34) == 5.0, "Point.length(p): 'self' is an ordinary explicit first parameter");

	assert(Point.manhattan(p34) == 7, "single-arg overload calls Point.origin() and the two-arg overload");
	assert(Point.manhattan(p34, Point { x: 1, y: 1 }) == 5, "struct functions overload by arity/type like top-level fns");

	Point scaled_p = Point.scaled(p34, 2);
	assert(scaled_p.x == 6 && scaled_p.y == 8, "a struct function's own nested closure captures its parameter");

	Line diag = Line { start: Point { x: 0, y: 0 }, end: Point { x: 3, y: 4 } };
	assert(Line.length(diag) == 5.0, "one struct's function calling a different struct's function");
}

// A hot loop counter (i) is exactly the kind of local the JIT's own
// register allocator (see jit_compile.c's select_register_local())
// picks for r15. Constructing a struct on every iteration used to
// clobber that register outright: emit_op_struct() borrowed r15 as
// scratch for the new instance's own pointer, unaware r15 might
// already be live for the whole function. total accumulates 2*i each
// iteration (i itself, plus p.x which mirrors it) specifically so a
// corrupted counter shows up as a wrong sum, not just a wrong loop
// trip count.
fn sum_with_struct_in_loop(int n) -> int {
	int total = 0;
	int i = 0;
	while (i < n) {
		total = total + i;
		Point p = Point { x: i, y: i };
		total = total + p.x;
		i = i + 1;
	}
	return total;
}

fn test_struct_in_loop_jit() {
	assert(sum_with_struct_in_loop(5) == 20, "a struct built inside a loop alongside a JIT register-allocated counter must not corrupt it");
}

// A struct-typed local can be assigned `null` (any declared type unifies
// with it), including one the JIT register-allocates (see
// jit_compile.c's emit_op_get_local(): a VAL_OBJ-typed binding
// reconstructs null-vs-real-object at runtime from whether its register
// is zero, unlike a scalar binding's permanently fixed tag). Repeatedly
// flips a register-cached struct local between null and a real value,
// both compared against `null` and against each other, and separately
// confirms a register-cached scalar local surviving a `null` assignment
// still reads back correctly (compiler.c's disqualify_local_reg_slot():
// a scalar's payload being 0 is ambiguous with a real 0, so a slot ever
// assigned null falls back to ordinary memory-resident handling instead
// of trying to reconstruct the tag the way an object binding does).
fn test_register_cached_null_locals() {
	Point p = null;
	assert(p == null, "a struct local's own null initializer must read back as null");

	p = Point.origin();
	assert(p != null, "a struct local reassigned away from null must no longer compare equal to null");
	assert(p.x == 0 && p.y == 0, "the reassigned struct's own fields must be readable");

	p = null;
	assert(p == null, "a struct local reassigned back to null must read back as null again");

	int scalar = 5;
	scalar += 1;
	assert(scalar == 6, "an ordinary register-cached scalar must still work before any null assignment");
	scalar = null;
	assert(scalar == null, "a register-cached scalar local assigned null must read back as null, not a corrupted 0");
}

// A struct local held live across a call to a function that itself
// allocates heavily (jit_compile.c's emit_gc_check() runs, and under
// PAWELI_GC_STRESS=1 actually collects, at every OP_ARRAY/OP_STRUCT/
// OP_CALL inside allocate_a_lot()'s own hot loop) exercises the actual
// GC-safety fix this feature exists for: if a register-cached struct
// local's live pointer were ever invisible to mark_roots() during one
// of those collections, this would read back a freed/corrupted pointer
// afterward instead of the same struct it held before the call.
// Deliberately checked against a value computed independently of the
// call (p.x/p.y set before allocate_a_lot() ever runs), so a stale or
// swept-then-reused pointer would show up as a wrong field read here,
// not just a crash.
fn allocate_a_lot() -> int {
	int total = 0;
	int i = 0;

	while (i < 200) {
		Point junk_point = Point { x: i, y: i };
		string[] junk_array = ["a", "b", "c"];
		total = total + junk_point.x + stdlib.length(junk_array);
		i = i + 1;
	}

	return total;
}

fn test_struct_survives_across_allocating_call() {
	Point p = Point { x: 3, y: 6 };
	int result = allocate_a_lot();

	assert(p.x == 3 && p.y == 6, "a register-cached struct local must survive a call that triggers real allocation and collection");
	assert(result == 20500, "the allocating call's own return value must still be correct");
}

fn main() {
	export test_field_read_write;
	export test_pass_return_functions;
	export test_nested_struct_fields;
	export test_default_field_values;
	export test_struct_equality_identity;
	export test_self_referencing_struct;
	export test_bare_literal_inference;
	export test_struct_functions;
	export test_struct_in_loop_jit;
	export test_register_cached_null_locals;
	export test_struct_survives_across_allocating_call;
}
