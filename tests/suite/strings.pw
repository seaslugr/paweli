#moduledef "strings"

fn test_split() {
	string s = "3 + 4";
	string[] tokens = stdlib.split(s, " ");
	assert(stdlib.length(tokens) == 3);
	assert(tokens[0] == "3");
	assert(tokens[1] == "+");
	assert(tokens[2] == "4");

	string[] collapsed = stdlib.split("a   b   c", " ");
	assert(stdlib.length(collapsed) == 3);
	assert(collapsed[0] == "a");
	assert(collapsed[1] == "b");
	assert(collapsed[2] == "c");

	string[] multi_char = stdlib.split("one::two::three", "::");
	assert(stdlib.length(multi_char) == 3);
	assert(multi_char[1] == "two");
}

fn test_concatenation() {
	string a = "foo";
	string b = "bar";
	assert(a + b == "foobar");
	assert("foo" + "bar" == stdlib.concat("foo", "bar"));

	string c = "foo";
	c += "bar";
	assert(c == "foobar");
}

fn test_indexing() {
	string s = "3 + 4";
	assert(s[0] == "3");
	assert(s[2] == "+");
	assert(s[4] == "4");
	assert(stdlib.length(s[0]) == 1);
}

// The character-iteration half of what used to be for_each.pw; the
// array-iteration half lives in arrays.pw instead.
fn test_foreach_characters() {
	string chars = "";
	for (string c : "abc") {
		chars = stdlib.concat(chars, c);
	}
	assert(chars == "abc", "foreach over a string iterates its characters");
}

// Regression test for a JIT bug found in review: the JIT's shared
// arithmetic slow path (emit_call_binary_slow_path, jit_compile.c)
// used to assume vm_binary_op()/vm_bitwise_op() never allocate, but
// OP_ADD on two strings does (object_new_string_concat()). A JIT'd
// loop doing nothing but string concatenation reached that slow path
// on every iteration with no paired emit_gc_check(), so the heap grew
// without bound. This is also exercised under PAWELI_GC_SAFEPOINT_CHECK
// (scripts/run_tests.sh runs the whole suite with it on by default),
// which aborts immediately if that gap ever regresses instead of just
// quietly using more memory.
fn build_repeated(int count) -> int {
	string s = "";
	int i = 0;
	while (i < count) {
		s = s + "x";
		i = i + 1;
	}
	return stdlib.length(s);
}

fn test_jit_string_concat_loop() {
	assert(build_repeated(8000) == 8000, "a JIT-compiled hot loop of nothing but string concatenation must still produce the correct length");
}

fn main() {
	export test_split;
	export test_concatenation;
	export test_indexing;
	export test_foreach_characters;
	export test_jit_string_concat_loop;
}
