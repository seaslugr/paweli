#moduledef "modules"

#module "fixtures/geometry"
#module "fixtures/transitive_mid"
#module "fixtures/diamond_a"
#module "fixtures/diamond_b"

fn test_basic_module_functions() {
	assert(geometry.area(3, 4) == 12);
	assert(geometry.area(1.5, 2.0) == 3.0);
	assert(geometry.perimeter(3, 4) == 14);
}

// Exported struct: Rect is constructed and read on this side of the
// #module boundary using the unqualified name, and passed to/returned
// from an exported function, proving the imported struct_def_t is
// the same type on both sides.
fn test_exported_struct_across_boundary() {
	Rect r = Rect { w: 5, h: 4 };
	assert(geometry.rect_area(r) == 20);
	Rect made = geometry.make_rect(6, 7);
	assert(made.w == 6);
	assert(made.h == 7);
	assert(geometry.rect_area(made) == 42);
}

// Rect's struct functions cross the #module boundary too, auto-exported
// with the type, and referenced unqualified (Rect.square, not
// geometry.Rect.square), the same way the type itself already is.
fn test_exported_struct_functions_unqualified() {
	Rect sq = Rect.square(4);
	assert(sq.w == 4 && sq.h == 4);
	assert(Rect.area(sq) == 16);
}

// A transitive #module chain: fixtures/transitive_mid itself imports
// fixtures/transitive_leaf. That second hop is exactly what was
// impossible before transitive imports existed (a #moduledef file
// could never itself carry a #module import).
fn test_transitive_module_chain() {
	assert(transitive_mid.sextuple(5) == 30);
}

// A diamond: fixtures/diamond_a and fixtures/diamond_b both import
// fixtures/diamond_shared. diamond_shared must compile exactly once,
// not once per importer: if it compiled twice, diamond_a's Shared and
// diamond_b's Shared would be two different struct_def_t instances,
// and the call below would be a compile-time type mismatch instead of
// working at all.
fn test_diamond_module_dedup() {
	assert(diamond_b.read_value(diamond_a.from_a(7)) == 7);
}

fn main() {
	export test_basic_module_functions;
	export test_exported_struct_across_boundary;
	export test_exported_struct_functions_unqualified;
	export test_transitive_module_chain;
	export test_diamond_module_dedup;
}
