fn make_counter() -> int {
	int count = 0;

	fn increment() -> int {
		count = count + 1;
		return count;
	}

	assert(increment() == 1);
	assert(increment() == 2);
	assert(increment() == 3);
	return count;
}

fn make_two_closures_same_capture() {
	int shared = 0;

	fn bump_a() {
		shared = shared + 1;
	}

	fn bump_b() {
		shared = shared + 10;
	}

	bump_a();
	bump_b();
	bump_a();

	assert(shared == 12, "two closures over the same local must share one upvalue");
}

fn capture_param(int base) -> int {
	fn add_base(int x) -> int {
		return x + base;
	}

	return add_base(5) + add_base(10);
}

fn fib(int n) -> int {
	fn go(int k) -> int {
		if (k < 2) {
			return k;
		}
		return go(k - 1) + go(k - 2);
	}

	return go(n);
}

fn main() {
	assert(make_counter() == 3);
	make_two_closures_same_capture();
	assert(capture_param(100) == 215);
	assert(fib(10) == 55);
	print("closures ok");
}
