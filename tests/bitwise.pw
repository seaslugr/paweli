fn main() {
	assert((6 & 3) == 2);
	assert((6 | 3) == 7);
	assert((6 ^ 3) == 5);
	assert(~0 == -1);
	assert(~5 == -6);
	assert((1 << 4) == 16);
	assert((256 >> 4) == 16);
	assert((1 << 0) == 1);
	assert((1 << 63) < 0);
	assert((-1 >> 1) == -1);

	// Precedence: | loosest, then ^, then &, all above equality/comparison,
	// but below the shift/additive/multiplicative tier.
	assert((1 | 2 & 3) == (1 | (2 & 3)));
	assert((1 ^ 2 & 3) == (1 ^ (2 & 3)));
	assert((2 + 3 << 1) == ((2 + 3) << 1));
	assert((1 << 2 == 4) == ((1 << 2) == 4));

	int x = 12;
	assert((x & 8) == 8);

	print("bitwise ok");
}
